# Настройки сервера для docker-compose.yml.
# Скопируйте в .env и заполните: cp .env.example .env

# Домен сайта. Без домена укажите :80 — сайт откроется по IP, но без HTTPS
# (тогда ниже поставьте COOKIE_SECURE=0, иначе вход не будет работать)
DOMAIN=career.example.ru

# Ключ подписи: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=замените-на-длинный-случайный-ключ

ALLOWED_HOSTS=career.example.ru
CSRF_TRUSTED_ORIGINS=https://career.example.ru
COOKIE_SECURE=1

# База данных: пароль придумайте свой
POSTGRES_DB=nis_db
POSTGRES_USER=nis
POSTGRES_PASSWORD=замените-на-надёжный-пароль
